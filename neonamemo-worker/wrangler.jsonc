{
  "name": "neonamemo-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "DEVICES",
      "id": "bdf3b2c3e3fd49c9b5fe3d7c75af27db"
    }
  ],
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "FILES_R2",
      "bucket_name": "neonamemo-files"
    }
  ]
}
